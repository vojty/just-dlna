{
  "components": {
    "schemas": {
      "Config": {
        "additionalProperties": false,
        "properties": {
          "file": {
            "description": "Path of the config file.",
            "type": "string"
          },
          "mediaPath": {
            "description": "Absolute path of the media folder served over DLNA.",
            "type": "string"
          },
          "restartPending": {
            "description": "Saved settings wait for a restart to apply.",
            "type": "boolean"
          },
          "settings": {
            "items": {
              "$ref": "#/components/schemas/Setting"
            },
            "type": "array"
          }
        },
        "required": [
          "file",
          "mediaPath",
          "restartPending",
          "settings"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "FileEntry": {
        "additionalProperties": false,
        "properties": {
          "isDir": {
            "type": "boolean"
          },
          "kind": {
            "enum": [
              "folder",
              "video",
              "subtitle",
              "other"
            ],
            "type": "string"
          },
          "modTime": {
            "format": "date-time",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "description": "Slash-separated path relative to the media folder.",
            "type": "string"
          },
          "size": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "name",
          "path",
          "isDir",
          "size",
          "modTime",
          "kind"
        ],
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "startedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "ok",
          "startedAt"
        ],
        "type": "object"
      },
      "Listing": {
        "additionalProperties": false,
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/components/schemas/FileEntry"
            },
            "type": "array"
          },
          "path": {
            "description": "Path of the folder, \".\" for the media folder itself.",
            "type": "string"
          }
        },
        "required": [
          "path",
          "entries"
        ],
        "type": "object"
      },
      "MkdirRequest": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "description": "Path of the new folder.",
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "type": "object"
      },
      "MoveRequest": {
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        },
        "required": [
          "from",
          "to"
        ],
        "type": "object"
      },
      "Setting": {
        "additionalProperties": false,
        "properties": {
          "default": {
            "description": "Value without the config file.",
            "type": "string"
          },
          "env": {
            "type": "string"
          },
          "fileValue": {
            "description": "Value in the config file, if set there.",
            "type": "string"
          },
          "locked": {
            "description": "Set by a command line flag or environment variable, so not editable.",
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "options": {
            "description": "Allowed values of an enum setting.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "source": {
            "enum": [
              "flag",
              "env",
              "file",
              "default"
            ],
            "type": "string"
          },
          "type": {
            "enum": [
              "string",
              "int",
              "bool",
              "enum",
              "list"
            ],
            "type": "string"
          },
          "usage": {
            "type": "string"
          },
          "value": {
            "description": "Value of the running server.",
            "type": "string"
          }
        },
        "required": [
          "name",
          "env",
          "usage",
          "type",
          "value",
          "default",
          "source",
          "locked"
        ],
        "type": "object"
      },
      "Uploaded": {
        "additionalProperties": false,
        "properties": {
          "files": {
            "items": {
              "$ref": "#/components/schemas/FileEntry"
            },
            "type": "array"
          }
        },
        "required": [
          "files"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "just-dlna admin API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/config": {
      "get": {
        "operationId": "getConfig",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Config"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Get the settings",
        "tags": [
          "server"
        ]
      },
      "put": {
        "description": "The saved settings apply after a restart.",
        "operationId": "saveConfig",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "description": "Setting names mapped to new values; null removes a setting from the config file (back to default).",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Config"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Bad Request"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Save settings to the config file",
        "tags": [
          "server"
        ]
      }
    },
    "/api/files": {
      "delete": {
        "operationId": "deleteFile",
        "parameters": [
          {
            "description": "Slash-separated path relative to the media folder; empty for the media folder itself.",
            "explode": false,
            "in": "query",
            "name": "path",
            "schema": {
              "description": "Slash-separated path relative to the media folder; empty for the media folder itself.",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Delete a file or folder with its content",
        "tags": [
          "files"
        ]
      },
      "get": {
        "operationId": "listFiles",
        "parameters": [
          {
            "description": "Slash-separated path relative to the media folder; empty for the media folder itself.",
            "explode": false,
            "in": "query",
            "name": "path",
            "schema": {
              "description": "Slash-separated path relative to the media folder; empty for the media folder itself.",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Listing"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "List a folder",
        "tags": [
          "files"
        ]
      }
    },
    "/api/files/download": {
      "get": {
        "description": "Supports range requests.",
        "operationId": "downloadFile",
        "parameters": [
          {
            "description": "Slash-separated path relative to the media folder; empty for the media folder itself.",
            "explode": false,
            "in": "query",
            "name": "path",
            "schema": {
              "description": "Slash-separated path relative to the media folder; empty for the media folder itself.",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {
                "schema": {
                  "contentMediaType": "application/octet-stream",
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "The file content."
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Download a file",
        "tags": [
          "files"
        ]
      }
    },
    "/api/files/mkdir": {
      "post": {
        "operationId": "createFolder",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MkdirRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileEntry"
                }
              }
            },
            "description": "Created"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Create a folder",
        "tags": [
          "files"
        ]
      }
    },
    "/api/files/move": {
      "post": {
        "operationId": "moveFile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MoveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileEntry"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Rename or move a file or folder",
        "tags": [
          "files"
        ]
      }
    },
    "/api/files/upload": {
      "post": {
        "operationId": "uploadFiles",
        "parameters": [
          {
            "description": "Folder to upload into; empty for the media folder itself.",
            "explode": false,
            "in": "query",
            "name": "path",
            "schema": {
              "description": "Folder to upload into; empty for the media folder itself.",
              "type": "string"
            }
          },
          {
            "description": "Replace existing files.",
            "explode": false,
            "in": "query",
            "name": "overwrite",
            "schema": {
              "description": "Replace existing files.",
              "type": "boolean"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file": {
                    "items": {
                      "contentMediaType": "application/octet-stream",
                      "format": "binary",
                      "type": "string"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "file"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Uploaded"
                }
              }
            },
            "description": "Created"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Upload files into a folder",
        "tags": [
          "files"
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Check that the server is up",
        "tags": [
          "server"
        ]
      }
    },
    "/api/restart": {
      "post": {
        "operationId": "restart",
        "responses": {
          "202": {
            "description": "Accepted"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Restart the server to apply saved settings",
        "tags": [
          "server"
        ]
      }
    }
  }
}
